; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Donde Estan Los Mios"
config/description="La semana del perro"
run/main_scene="res://scenes/main/intro.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/ui/icono.png"

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
CharacterDatabase="*res://scripts/autoload/CharacterDatabase.gd"
MissionDatabase="*res://scripts/autoload/MissionDatabase.gd"
MissionManager="*res://scripts/autoload/MissionManager.gd"
DialogueManager="*res://scripts/autoload/DialogueManager.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

